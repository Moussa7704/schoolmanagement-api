# Copier ce fichier en .env puis remplir les valeurs.
# Ne jamais commiter le vrai .env (il est dans .gitignore).

# Serveur
PORT=9090
# "production" active les cookies sécurisés (HTTPS) ; "development" par défaut
NODE_ENV=development

# Frontend autorisé (CORS) et URL utilisée dans les liens envoyés par e-mail
CLIENT_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Compte e-mail d'envoi (OTP, réinitialisation du mot de passe)
EMAIL_USER=
EMAIL_PASS=

# Base de données
DB_NAME=schoolmanagement
DB_USER=postgres
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# JWT — durées au format "15m", "1h", "7d"
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

# Secrets JWT : une longue chaîne aléatoire différente pour chacun, par ex.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=
REFRESH_SECRET=
RESET_SECRET=

# Développement uniquement : stocke les codes de connexion (OTP) EN CLAIR dans la
# table Otps, pour tester avec de fausses adresses e-mail. Toujours ignoré si
# NODE_ENV=production (les codes y sont toujours hachés). Laisser à false sinon.
OTP_DEV_PLAIN_CODES=false
